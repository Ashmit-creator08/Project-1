# --- LLM provider (Phase 4: Groq) ---------------------------------------------------
# Get a key at https://console.groq.com/keys. Without a key the app runs in
# fallback-only mode (rating-ranked results, template explanations).
LLM_PROVIDER=groq
GROQ_API_KEY=
# Optional overrides (defaults come from the provider preset):
# LLM_MODEL=openai/gpt-oss-120b         # ranker (strict JSON schema output)
# JUDGE_MODEL=openai/gpt-oss-20b        # eval-only LLM-as-judge
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_RESPONSE_FORMAT=auto              # auto | json_schema | json_object | none
# LLM_REASONING_EFFORT=low              # gpt-oss only: low | medium | high
LLM_TIMEOUT_SECONDS=20
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1200
# Honour a 429 retry-after only if it is this short; otherwise fall back immediately.
LLM_MAX_RETRY_WAIT_SECONDS=2
# Prompt variant: v1_baseline | v2_stricter_json (see the A/B scorecard)
PROMPT_VARIANT=v2_stricter_json
# Other providers:
#   LLM_PROVIDER=openai  LLM_API_KEY=sk-...
#   LLM_PROVIDER=custom  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1   (Ollama, no key)

# --- Data ------------------------------------------------------------------------
# Relative paths resolve from the repo root
DATA_PATH=data/processed/restaurants.parquet
MAX_CANDIDATES=30
TOP_N_DEFAULT=5

# --- Hardening (Phase 4) ---------------------------------------------------------
# Response cache TTL in seconds (0 disables)
CACHE_TTL_SECONDS=600
CACHE_MAX_ENTRIES=256
# Requests per minute per client on POST /api/v1/recommendations (0 disables)
RATE_LIMIT_PER_MINUTE=30

# --- Deployment ------------------------------------------------------------------
LOG_LEVEL=INFO
# text for local runs, json for log aggregators
LOG_FORMAT=text
# Comma-separated browser origins allowed to call the API directly (empty = CORS off)
CORS_ALLOW_ORIGINS=
# When set, GET /metrics requires "Authorization: Bearer <token>"
METRICS_TOKEN=

# --- UI only ---------------------------------------------------------------------
# Call the REST API instead of running the service in-process
# RECOMMENDER_API_URL=http://localhost:8000
